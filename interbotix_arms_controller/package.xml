  <version>0.0.0</version>
  <description>This package will help us in controlling the interbotix robot arms</description>
  <maintainer email="dasc14@gmail.com">Daniel Sosa</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
