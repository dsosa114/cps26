<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gripper">
    <xacro:property name="finger_limit_effort"        value="5"/>
    <xacro:property name="finger_limit_lower"         value="0.015"/>
    <xacro:property name="finger_limit_upper"         value="0.037"/>
    <xacro:property name="finger_limit_vel"           value="1"/>
    
    <xacro:macro name="gripper" params="tf_prefix attach_link">
        <link name="${tf_prefix}gripper_prop_link">
            <visual>
                <origin xyz="-0.0685 0.0 0.0" rpy="0.0 0.0 ${pi/2}"/>
                <geometry>
                    <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_prop.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="-0.0685 0.0 0.0" rpy="0.0 0.0 ${pi/2}"/>
                <geometry>
                    <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_prop.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <origin
                rpy="0 0 ${pi/2}"
                xyz="0.0008460000 -0.0000019330 0.0000420000"/>
                <mass value="0.00434"/>
                <inertia
                ixx="0.0000005923"
                iyy="0.0000011156"
                izz="0.0000005743"
                ixy="0.0000000000"
                ixz="0.0000003195"
                iyz="-0.0000000004"/>
            </inertial>
        </link>
        <joint name="gripper" type="revolute">
            <parent link="${attach_link}"/>
            <child link="${tf_prefix}gripper_prop_link"/>
            <axis xyz="1 0 0"/>
            <origin xyz="0.0055 0 0" rpy="0 0 0"/>
            <limit lower="0.0" upper="${2*pi}" effort="5.0" velocity="1.0"/>
        </joint>
        <link name="${tf_prefix}gripper_bar_link">
            <visual>
                <origin rpy="0 0 ${pi/2}" xyz="-0.063 0 0"/>
                <geometry>
                    <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_bar.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="black">
                    <color rgba="0.9 0.9 0.9 1.0"/>
                </material>
            </visual>
            <collision>
                <origin rpy="0 0 ${pi/2}" xyz="-0.063 0 0"/>
                <geometry>
                    <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_bar.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <inertial>
                <origin
                    rpy="0 0 ${pi/2}"
                    xyz="0.0096870000 0.0000005660 0.0049620000"/>
                <mass value="0.034199"/>
                <inertia
                    ixx="0.0000074125"
                    iyy="0.0000284300"
                    izz="0.0000286000"
                    ixy="-0.0000000008"
                    ixz="-0.0000000006"
                    iyz="-0.0000013889"/>
            </inertial>
        </link>
        <joint name="gripper_bar" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <parent link="${tf_prefix}ee_arm_link"/>
            <child link="${tf_prefix}gripper_bar_link"/>
        </joint>
        <link name="${tf_prefix}fingers_link"/>
        <joint name="ee_bar" type="fixed">
            <origin rpy="0 0 0" xyz="0.023 0 0"/>
            <parent link="${tf_prefix}gripper_bar_link"/>
            <child link="${tf_prefix}fingers_link"/>
        </joint>
        <link name="${tf_prefix}left_finger_link">
          <visual>
            <origin rpy="${pi} ${pi} 0" xyz="0 0.005 0"/>
            <geometry>
              <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
          </visual>
          <collision>
            <origin rpy="${pi} ${pi} 0" xyz="0 0.005 0"/>
            <geometry>
              <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
          </collision>
          <inertial>
            <origin
              rpy="${pi} ${pi} ${pi/2}"
              xyz="0.0138160000 0.0000000000 0.0000000000"/>
            <mass value="0.016246"/>
            <inertia
              ixx="0.0000047310"
              iyy="0.0000015506"
              izz="0.0000037467"
              ixy="-0.0000004560"
              ixz="0.0000000000"
              iyz="0.0000000000"/>
          </inertial>
        </link>
        <joint name="left_finger" type="prismatic">
          <axis xyz="0 1 0"/>
          <limit effort="${finger_limit_effort}" lower="${finger_limit_lower}" upper="${finger_limit_upper}" velocity="${finger_limit_vel}"/>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <parent link="${tf_prefix}fingers_link"/>
          <child link="${tf_prefix}left_finger_link"/>
          <dynamics friction="0.1" damping="0.1"/>
          <mimic joint="gripper" multiplier="0.00350140875" offset="${finger_limit_lower}"/>
        </joint>
        <link name="${tf_prefix}right_finger_link">
          <visual>
            <origin rpy="0 ${pi} 0" xyz="0 -0.005 0"/>
            <geometry>
              <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
          </visual>
          <collision>
            <origin rpy="0 ${pi} 0" xyz="0 -0.005 0"/>
            <geometry>
              <mesh filename="file://$(find custom_interbotix_xarms_description)/meshes/px150_meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
          </collision>
          <inertial>
            <origin
              rpy="0 ${pi} ${pi/2}"
              xyz="0.0138160000 0.0000000000  0.0000000000"/>
            <mass value="0.016246"/>
            <inertia
              ixx="0.0000047310"
              iyy="0.0000015506"
              izz="0.0000037467"
              ixy="0.0000004560"
              ixz="0.0000000000"
              iyz="0.0000000000"/>
          </inertial>
        </link>
        <joint name="right_finger" type="prismatic">
          <axis xyz="0 1 0"/>
          <limit effort="${finger_limit_effort}" lower="${-finger_limit_upper}" upper="${-finger_limit_lower}" velocity="${finger_limit_vel}"/>
          <origin rpy="0 0 0" xyz="0 0 0"/>
          <parent link="${tf_prefix}fingers_link"/>
          <child link="${tf_prefix}right_finger_link"/>
          <dynamics friction="0.1" damping="0.1"/>
          <mimic joint="left_finger" multiplier="-1" offset="0"/>
        </joint>
        <link name="${tf_prefix}ee_gripper_link"/>
        <joint name="ee_gripper" type="fixed">
          <origin rpy="0 0 0" xyz="0.027575 0 0"/>
          <parent link="${tf_prefix}fingers_link"/>
          <child link="${tf_prefix}ee_gripper_link"/>
        </joint>
    </xacro:macro> 
</robot>