<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="camera_length" value="0.01" />
    <xacro:property name="camera_width" value="0.1"/>
    <xacro:property name="camera_height" value="0.05" />

    <link name="camera_link">
        <xacro:box_inertia m="0.01" l="${camera_length}" w="${camera_width}" h="${camera_height}" o_xyz="0 0 0" o_rpy="0 0 0"/>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="${(base_length + camera_length)/2.0} 0.0 ${base_height/2.0}" rpy="0.0 0.0 0.0"/>
    </joint>
    <gazebo reference="camera_link">
       <sensor name="front_camera_sensor" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>camera/image_raw</topic>
            <frame_id>camera_link</frame_id>
            <camera name="rgb_camera">
                <camera_info_camera>camera/camera_info</camera_info_camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.001</stddev>
                </noise>
            </camera>
       </sensor>
    </gazebo>  
</robot>